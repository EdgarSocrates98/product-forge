{
  "schema": "forge/SpecialistAgenticManifest/v1",
  "provider": "product-forge",
  "version": "0.2.5",
  "cli": "productforge",
  "cli_entry": "product_forge.cli:app",
  "workflows": [
    {
      "id": "doctor",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "doctor"
      ],
      "description": "Environment health and capability diagnostics",
      "read_only": true
    },
    {
      "id": "product-context",
      "mode": "DIRECT_CAPABILITY",
      "command": [
        "{cli}",
        "product",
        "context",
        "{product_id}"
      ],
      "description": "Recover the Product Context Package for a product",
      "read_only": true
    },
    {
      "id": "knowledge-query",
      "mode": "DIRECT_CAPABILITY",
      "command": [
        "{cli}",
        "knowledge",
        "query",
        "{product_id}",
        "{question}"
      ],
      "description": "Grounded answer over product knowledge with citations",
      "read_only": true
    },
    {
      "id": "knowledge-import",
      "mode": "DIRECT_CAPABILITY",
      "command": [
        "{cli}",
        "knowledge",
        "import",
        "{product_id}",
        "{file}"
      ],
      "description": "Import a local Markdown document with an auditable receipt",
      "read_only": false
    },
    {
      "id": "obsidian.preview",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "knowledge",
        "obsidian",
        "preview",
        "{path}"
      ],
      "description": "Preview authorized Obsidian note metadata and projection",
      "read_only": true
    },
    {
      "id": "obsidian.import",
      "mode": "DIRECT_CAPABILITY",
      "command": [
        "{cli}",
        "knowledge",
        "obsidian",
        "import",
        "{product_id}",
        "{path}"
      ],
      "description": "Import one selected authorized Obsidian note into product knowledge",
      "read_only": false
    },
    {
      "id": "obsidian.export",
      "mode": "DIRECT_CAPABILITY",
      "command": [
        "{cli}",
        "knowledge",
        "obsidian",
        "export",
        "{path}",
        "{file}",
        "--yes"
      ],
      "description": "Export a reviewed knowledge document to the authorized Obsidian vault",
      "read_only": false
    },
    {
      "id": "obsidian.sync.plan",
      "mode": "DIRECT_CAPABILITY",
      "command": [
        "{cli}",
        "knowledge",
        "obsidian",
        "sync-plan",
        "{path}",
        "{file}"
      ],
      "description": "Plan a reviewed Obsidian sync without mutation",
      "read_only": true
    },
    {
      "id": "obsidian.sync.apply",
      "mode": "DIRECT_CAPABILITY",
      "command": [
        "{cli}",
        "knowledge",
        "obsidian",
        "export",
        "{path}",
        "{file}",
        "--yes"
      ],
      "description": "Apply an explicitly reviewed Obsidian sync and emit a receipt",
      "read_only": false
    },
    {
      "id": "knowledge.evidence.list",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "knowledge",
        "evidence",
        "{product_id}"
      ],
      "description": "List body-free knowledge evidence and provenance",
      "read_only": true
    },
    {
      "id": "knowledge.context.project",
      "mode": "DIRECT_CAPABILITY",
      "command": [
        "{cli}",
        "product",
        "context",
        "{product_id}"
      ],
      "description": "Recover the Product Context Package for a product",
      "read_only": true
    }
  ],
  "skills": [],
  "agents": [
    "agent-ops-coordinator",
    "data-analyst-coordinator",
    "integration-coordinator",
    "planning-coordinator",
    "product-intel-coordinator"
  ],
  "coordinators": [],
  "mcp_command": [
    "{cli}",
    "mcp",
    "serve"
  ],
  "mcp_verify_tool": "productforge_status",
  "host_adapters": [
    "claude",
    "devin",
    "codex",
    "copilot"
  ],
  "host_partial": {
    "cursor": "marker + .mcp.json only — no skill/agent catalog adapter"
  },
  "read_only_default": true,
  "requires_aws_credentials": false,
  "requires_llm": false,
  "resources": [
    {
      "id": "pf-agent-factory",
      "kind": "skill",
      "location": "skills/pf-agent-factory/SKILL.md",
      "resource_class": "agentic"
    },
    {
      "id": "pf-analytics",
      "kind": "skill",
      "location": "skills/pf-analytics/SKILL.md",
      "resource_class": "agentic"
    },
