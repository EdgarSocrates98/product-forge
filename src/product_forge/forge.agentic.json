    },
    {
      "id": "pf-knowledge",
      "kind": "skill",
      "location": "skills/pf-knowledge/SKILL.md",
      "resource_class": "agentic"
    },
    {
      "id": "pf-prioritization",
      "kind": "skill",
      "location": "skills/pf-prioritization/SKILL.md",
      "resource_class": "agentic"
    },
    {
      "id": "pf-product-discovery",
      "kind": "skill",
      "location": "skills/pf-product-discovery/SKILL.md",
      "resource_class": "agentic"
    },
    {
      "id": "pf-product-strategy",
      "kind": "skill",
      "location": "skills/pf-product-strategy/SKILL.md",
      "resource_class": "agentic"
    },
    {
      "id": "pf-reporting",
      "kind": "skill",
      "location": "skills/pf-reporting/SKILL.md",
      "resource_class": "agentic"
    },
    {
      "id": "pf-requirements",
      "kind": "skill",
      "location": "skills/pf-requirements/SKILL.md",
      "resource_class": "agentic"
    },
    {
      "id": "pf-sql",
      "kind": "skill",
